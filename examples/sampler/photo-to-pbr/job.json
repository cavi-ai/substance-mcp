{
  "schema": 1,
  "directory": "jobs/photo-to-pbr",
  "project": {
    "name": "Photo PBR"
  },
  "steps": [
    {
      "action": "create_asset",
      "name": "PhotoPBR",
      "empty": true
    },
    {
      "action": "import_images",
      "asset": "PhotoPBR",
      "images": [
        "photos/albedo.png"
      ],
      "position": 0,
      "import_option": "image_to_material_B2M"
    },
    {
      "action": "insert_filter",
      "asset": "PhotoPBR",
      "filter": "Tiling",
      "position": 1
    },
    {
      "action": "set_parameters",
      "asset": "PhotoPBR",
      "layer": "Tiling",
      "parameters": {
        "Threshold": 0.1
      }
    },
    {
      "action": "export",
      "asset": "PhotoPBR",
      "target": "unreal",
      "resolution": 2048
    }
  ]
}
